{
	"name": "df_detalle_ventas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_detalle_pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_sql_detalle_pedidos",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "cast1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(cantidad = lower(trim(cantidad)),",
				"          precio_unitario = replace(replace(trim(precio_unitario),'bolivianos',''),',','.'),",
				"          descuento_linea = lower(trim(descuento_linea))) ~> derivedColumn1",
				"derivedColumn1 split(\r",
				"!isInteger(cantidad)\r",
				"||\r",
				"!isDecimal(precio_unitario)\r",
				"||\r",
				"!isDecimal(descuento_linea)\r",
				"||\r",
				"!isDecimal(total_linea)\r",
				"||\r",
				"toDecimal(descuento_linea) < 0\r",
				"||\r",
				"toDecimal(descuento_linea) > 100,",
				"     disjoint: false) ~> split1@(rechazados, validos)",
				"split1@validos cast(output(",
				"          cantidad as integer,",
				"          precio_unitario as double,",
				"          descuento_linea as double,",
				"          total_linea as double",
				"     ),",
				"     errors: true) ~> cast1",
				"cast1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as integer,",
				"          precio_unitario as string,",
				"          descuento_linea as decimal(12,2),",
				"          total_linea as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          detalle_id,",
				"          pedido_id,",
				"          producto_id,",
				"          cantidad,",
				"          precio_unitario,",
				"          descuento_linea,",
				"          total_linea",
				"     )) ~> sink1"
			]
		}
	}
}