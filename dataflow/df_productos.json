{
	"name": "df_productos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(categoria = initCap(lower(trim(categoria))),",
				"          precio_texto = replace(     replace(trim(precio_lista), ' Bs', ''),     ',',     '.' )) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(producto_id) &&\r",
				"!isNull(precio_lista) &&\r",
				"!isNull(costo_estimado),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(precio_texto = toDecimal(precio_texto),",
				"          costo_estimado = toDecimal(costo_estimado)) ~> derivedColumn2"
			]
		}
	}
}