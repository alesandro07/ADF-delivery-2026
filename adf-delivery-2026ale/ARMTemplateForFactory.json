		{
			"name": "[concat(parameters('factoryName'), '/df_clientes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_clientes_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_sql_clientes",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "derivedColumn2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          cliente_id as string,",
						"          nombre as string,",
						"          email as string,",
						"          telefono as string,",
						"          ciudad as string,",
						"          fecha_registro as string,",
						"          segmento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(nombre = initCap(lower(trim(nombre))),",
						"          ciudad = initCap(lower(trim(ciudad))),",
						"          email = initCap(lower(trim(email)))) ~> derivedColumn1",
						"derivedColumn1 split(!isNull(cliente_id) &&\r",
						"!isNull(nombre) &&\r",
						"!isNull(ciudad) &&\r",
						"!isNull(email) &&\r",
						"email != '',",
						"     disjoint: false) ~> split1@(validos, rechazados)",
						"split1@validos aggregate(groupBy(cliente_id),",
						"     nombre = first(nombre),",
						"          email = first(email),",
