		{
			"name": "[concat(parameters('factoryName'), '/df_clientes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_clientes_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_sql_clientes",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "derivedColumn2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          cliente_id as string,",
						"          nombre as string,",
						"          email as string,",
						"          telefono as string,",
						"          ciudad as string,",
						"          fecha_registro as string,",
						"          segmento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(nombre = initCap(lower(trim(nombre))),",
						"          ciudad = initCap(lower(trim(ciudad))),",
						"          email = initCap(lower(trim(email)))) ~> derivedColumn1",
						"derivedColumn1 split(!isNull(cliente_id) &&\r",
						"!isNull(nombre) &&\r",
						"!isNull(ciudad) &&\r",
						"!isNull(email) &&\r",
						"email != '',",
						"     disjoint: false) ~> split1@(validos, rechazados)",
						"split1@validos aggregate(groupBy(cliente_id),",
						"     nombre = first(nombre),",
						"          email = first(email),",
						"          telefono = first(telefono),",
						"          ciudad = first(ciudad),",
						"          fecha_registro = first(fecha_registro),",
						"          segmento = first(segmento)) ~> aggregate1",
						"aggregate1 derive(fecha_registro = toDate(fecha_registro)) ~> derivedColumn2",
						"derivedColumn2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          cliente_id as string,",
						"          nombre as string,",
						"          email as string,",
						"          telefono as string,",
						"          ciudad as string,",
						"          fecha_registro as date,",
						"          segmento as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          cliente_id,",
						"          nombre,",
						"          email,",
						"          telefono,",
						"          ciudad,",
						"          fecha_registro,",
						"          segmento",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_productos')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_productos_menu_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_sql_productos_menu",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						},
						{
							"name": "derivedColumn2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          producto_id as string,",
						"          nombre_producto as string,",
						"          categoria as string,",
						"          precio_lista as string,",
						"          costo_estimado as string,",
						"          disponible as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(categoria = initCap(lower(trim(categoria))),",
						"          precio_texto = replace(     replace(trim(precio_lista), ' Bs', ''),     ',',     '.' )) ~> derivedColumn1",
						"derivedColumn1 split(!isNull(producto_id) &&\r",
						"!isNull(precio_lista) &&\r",
						"!isNull(costo_estimado),",
						"     disjoint: false) ~> split1@(validos, rechazados)",
						"split1@validos derive(precio_texto = toDecimal(precio_texto),",
						"          costo_estimado = toDecimal(costo_estimado)) ~> derivedColumn2",
						"derivedColumn2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          producto_id as string,",
						"          nombre_producto as string,",
						"          categoria as string,",
						"          precio_lista as string,",
						"          costo_estimado as decimal(12,2),",
						"          disponible as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          producto_id,",
						"          nombre_producto,",
						"          categoria,",
						"          precio_lista = precio_texto,",
						"          costo_estimado,",
						"          disponible",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_productos_menu')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_detalle_ventas')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_detalle_pedidos_csv",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_sql_detalle_pedidos",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "split1"
						},
						{
							"name": "cast1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          detalle_id as string,",
						"          pedido_id as string,",
						"          producto_id as string,",
						"          cantidad as string,",
						"          precio_unitario as string,",
						"          descuento_linea as string,",
						"          total_linea as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(cantidad = lower(trim(cantidad)),",
						"          precio_unitario = replace(replace(trim(precio_unitario),'bolivianos',''),',','.'),",
						"          descuento_linea = lower(trim(descuento_linea))) ~> derivedColumn1",
						"derivedColumn1 split(\r",
						"!isInteger(cantidad)\r",
						"||\r",
						"!isDecimal(precio_unitario)\r",
						"||\r",
						"!isDecimal(descuento_linea)\r",
						"||\r",
						"!isDecimal(total_linea)\r",
						"||\r",
						"toDecimal(descuento_linea) < 0\r",
						"||\r",
						"toDecimal(descuento_linea) > 100,",
						"     disjoint: false) ~> split1@(rechazados, validos)",
						"split1@validos cast(output(",
						"          cantidad as integer,",
						"          precio_unitario as double,",
						"          descuento_linea as double,",
						"          total_linea as double",
						"     ),",
						"     errors: true) ~> cast1",
						"cast1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          detalle_id as string,",
						"          pedido_id as string,",
						"          producto_id as string,",
						"          cantidad as integer,",
						"          precio_unitario as string,",
